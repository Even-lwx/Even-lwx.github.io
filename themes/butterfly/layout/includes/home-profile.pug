section.editorial-hero(aria-labelledby='editorial-home-title')
  .editorial-hero__edition
    span IF-ELSE / FIELD NOTES
    span EDITION 2026
  .editorial-hero__grid
    .editorial-hero__copy
      p.editorial-hero__kicker 嵌入式 · 控制系统 · 机器人
      h1#editorial-home-title
        span.editorial-hero__brand if-else
        span.editorial-hero__statement 做能运行的系统，写能复用的经验。
      p.editorial-hero__summary
        | 智能科学与技术本科生，关注无人机、智能车、轮足机器人与嵌入式工程。
        | 这里收录真实项目中的设计取舍、调试过程和技术复盘。
      .editorial-hero__actions
        a.editorial-button.editorial-button--primary(href=url_for('/projects/'))
          span 阅读项目档案
          i.fas.fa-arrow-right
        a.editorial-button(href=url_for('/archives/'))
          span 浏览技术文章
        a.editorial-icon-link(href='https://github.com/Even-lwx' target='_blank' rel='noopener noreferrer' title='GitHub' aria-label='访问 GitHub')
          i.fab.fa-github
        a.editorial-icon-link(href='mailto:1191228412@qq.com?subject=%E7%AE%80%E5%8E%86%E7%B4%A2%E5%8F%96%20-%20if-else' title='通过邮件索取简历' aria-label='通过邮件索取简历')
          i.fas.fa-envelope
    aside.editorial-hero__profile(aria-label='作者简介')
      figure.editorial-portrait
        img(src=url_for('/img/avatar.webp') width='320' height='320' alt='if-else 的个人头像')
        figcaption
          strong if-else
          span 持续构建，持续记录
      dl.editorial-dossier
        div
          dt 当前方向
          dd 嵌入式控制与机器人
        div
          dt 项目现场
          dd 飞控 / 智能车 / 轮足
        div
          dt 联系方式
          dd
            a(href='mailto:1191228412@qq.com') 1191228412@qq.com
  .editorial-proof(aria-label='项目成果')
    .editorial-proof__label ENGINEERING NOTES
    .editorial-proof__item
      strong 01
      span 智能车浙江赛区一等奖 · 第一名
    .editorial-proof__item
      strong 02
      span 两项核心机器人系统实践
    .editorial-proof__item
      strong 03
      span 一项发明专利已受理

section.editorial-section.editorial-projects(aria-labelledby='featured-projects-title')
  header.editorial-section__header
    .editorial-section__number 01
    .editorial-section__heading
      span.editorial-section__eyebrow SELECTED WORK
      h2#featured-projects-title 项目档案
      p 从约束、决策到联调结果，记录系统真正跑起来之前发生的事。
    a.editorial-section__more(href=url_for('/projects/'))
      span 查看全部项目
      i.fas.fa-arrow-right

  .editorial-project-list
    article.editorial-project.editorial-project--lead
      .editorial-project__meta
        span CASE 01
        strong 浙江赛区一等奖 · 第一名
      .editorial-project__body
        .editorial-project__symbol(aria-hidden='true')
          i.fas.fa-plane
        .editorial-project__content
          h3 四旋翼无人机空地有缆协同系统
          p 作为项目负责人，完成飞控运动控制、多传感器融合、视觉识别和路径规划，并推进空地系统联调闭环。
          .editorial-project__tags
            span TRAVEO
            span 串级 PID
            span 计算机视觉
          a.editorial-project__link(href=url_for('/projects/#air-ground-system'))
            span 打开项目档案
            i.fas.fa-arrow-right

    article.editorial-project
      .editorial-project__meta
        span CASE 02
        strong 新苗计划 · 专利受理
      .editorial-project__body
        .editorial-project__symbol.editorial-project__symbol--green(aria-hidden='true')
          i.fas.fa-robot
        .editorial-project__content
          h3 智能手机协同桌面级轮足机器人
          p 负责 FreeRTOS 软件架构、姿态解算、通信和多串级 PID，实现机器人自主平衡与单边桥前进。
          .editorial-project__tags
            span ESP32
            span FreeRTOS
            span EKF
          a.editorial-project__link(href=url_for('/projects/#wheeled-leg-robot'))
            span 打开项目档案
            i.fas.fa-arrow-right

-
  const featuredArticles = [
    {
      title: '智能车轮胎研究',
      topic: '工程分析',
      icon: 'fas fa-car-side',
      summary: '从材质、尺寸、胎压与胎面结构出发，分析轮胎选择对抓地力和车辆动态的影响。'
    },
    {
      title: 'M0603C电机使用',
      topic: '嵌入式控制',
      icon: 'fas fa-microchip',
      summary: '记录电机控制从 CRC 校验到限幅、反馈和开闭环切换的实现与迭代。'
    },
    {
      title: '12306 车票信息爬虫实验答辩报告+源码-python期末作业',
      topic: 'Python 实践',
      icon: 'fab fa-python',
      summary: '完整呈现方案比较、请求处理、数据解析、表格导出和答辩复盘。'
    },
    {
      title: '解锁 MCP 协议：开启 AI 新世界大门',
      topic: '技术理解',
      icon: 'fas fa-network-wired',
      summary: '从架构与能力边界出发，解释 MCP 与 Function Calling 的差异和协作方式。'
    }
  ]

section.editorial-section.editorial-writing(aria-labelledby='featured-writing-title')
  header.editorial-section__header
    .editorial-section__number 02
    .editorial-section__heading
      span.editorial-section__eyebrow EDITOR'S PICKS
      h2#featured-writing-title 代表性技术文章
      p 先读工程分析与实现复盘，再从主题索引继续探索。
    a.editorial-section__more(href=url_for('/archives/'))
      span 浏览全部文章
      i.fas.fa-arrow-right

  .editorial-writing-list
    each article, index in featuredArticles
      - const featuredPost = site.posts.findOne({ title: article.title })
      if featuredPost
        a.editorial-story(class=index === 0 ? 'editorial-story--lead' : '' href=url_for(featuredPost.path))
          .editorial-story__index= String(index + 1).padStart(2, '0')
          .editorial-story__icon(aria-hidden='true')
            i(class=article.icon)
          .editorial-story__copy
            span.editorial-story__topic= article.topic
            h3= article.title
            p= article.summary
          i.fas.fa-arrow-right.editorial-story__arrow(aria-hidden='true')

section.editorial-section.editorial-topics(aria-labelledby='home-topics-title')
  header.editorial-section__header
    .editorial-section__number 03
    .editorial-section__heading
      span.editorial-section__eyebrow FIELD INDEX
      h2#home-topics-title 按主题翻阅
  nav.editorial-topic-list(aria-label='文章主题')
    a.editorial-topic(href=url_for('/tags/智能车/'))
      span 01
      strong 智能车与机器人
      small 运动控制、结构与竞赛实践
      i.fas.fa-arrow-right
    a.editorial-topic(href=url_for('/tags/单片机/'))
      span 02
      strong 嵌入式开发
      small MCU、RTOS 与硬件调试
      i.fas.fa-arrow-right
    a.editorial-topic(href=url_for('/tags/c语言/'))
      span 03
      strong 编程与工具
      small C、Python 与工程效率
      i.fas.fa-arrow-right
    a.editorial-topic(href=url_for('/tags/期末复习/'))
      span 04
      strong 学习笔记
      small 课程复盘与知识整理
      i.fas.fa-arrow-right

section.editorial-feed-heading(aria-labelledby='latest-writing-title')
  .editorial-feed-heading__number 04
  .editorial-section__heading
    span.editorial-section__eyebrow LATEST NOTES
    h2#latest-writing-title 最近在写
    p 项目复盘、技术笔记，以及值得长期保留的学习记录。
  a.editorial-section__more(href=url_for('/archives/'))
    span 查看文章归档
    i.fas.fa-arrow-right
