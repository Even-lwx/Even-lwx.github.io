section.home-section.home-featured-writing(aria-labelledby='featured-writing-title')
  header.home-section__header
    .home-section__heading
      span.home-section__eyebrow FEATURED WRITING
      h2#featured-writing-title 代表性技术文章
      p 优先展示工程分析、嵌入式实现与完整项目复盘。
    a.home-section__more(href=url_for('/archives/'))
      span 浏览全部文章
      i.fas.fa-arrow-right

  .featured-writing-grid
    each article, index in featuredArticles
      - const featuredPost = site.posts.findOne({ title: article.title })
      if featuredPost
        a.featured-writing__item(href=url_for(featuredPost.path))
          .featured-writing__topline
            span.featured-writing__index= String(index + 1).padStart(2, '0')
            span.featured-writing__topic= article.topic
          i.featured-writing__icon(class=article.icon aria-hidden='true')
          h3= article.title
          p= article.summary
          span.featured-writing__link
            span 阅读文章
            i.fas.fa-arrow-right

section.home-section.home-topics(aria-labelledby='home-topics-title')
  header.home-section__header
    .home-section__heading
      span.home-section__eyebrow EXPLORE BY TOPIC
      h2#home-topics-title 从一个感兴趣的方向开始
  nav.home-topic-list(aria-label='文章主题')
    a.home-topic(href=url_for('/tags/智能车/'))
      i.fas.fa-car-side
      span
        strong 智能车与机器人
        small 运动控制、结构与竞赛实践
    a.home-topic(href=url_for('/tags/单片机/'))
      i.fas.fa-microchip
      span
        strong 嵌入式开发
        small MCU、RTOS 与硬件调试
    a.home-topic(href=url_for('/tags/c语言/'))
      i.fas.fa-terminal
      span
        strong 编程与工具
        small C、Python 与工程效率
    a.home-topic(href=url_for('/tags/期末复习/'))
      i.fas.fa-book-open
      span
        strong 学习笔记
        small 课程复盘与知识整理

section.home-writing-intro(aria-labelledby='latest-writing-title')
  .home-section__heading
    span.home-section__eyebrow LATEST WRITING
    h2#latest-writing-title 最近在写
    p 项目复盘、技术笔记，以及值得长期保留的学习记录。
  a.home-section__more(href=url_for('/archives/'))
    span 全部文章
    i.fas.fa-arrow-right
