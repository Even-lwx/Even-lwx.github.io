- const currentYear = new Date().getFullYear()
- const sinceYear = theme.footer.owner.since || currentYear

#footer-wrap.site-footer
  .site-footer__main
    .site-footer__identity
      a.site-footer__brand(href=url_for('/') title='返回首页')
        i.fas.fa-code
        span if-else
      p.site-footer__tagline 把控制算法写进真实系统，也把工程过程留在这里。
    nav.site-footer__nav(aria-label='页脚导航')
      a(href=url_for('/projects/'))
        i.fas.fa-code-branch
        span 项目
      a(href=url_for('/archives/'))
        i.fas.fa-book-open
        span 文章
      a(href='https://github.com/Even-lwx' target='_blank' rel='noopener noreferrer')
        i.fab.fa-github
        span GitHub
      a(href='mailto:1191228412@qq.com?subject=%E5%8D%9A%E5%AE%A2%E8%81%94%E7%B3%BB%20-%20if-else' title='发送邮件至 1191228412@qq.com')
        i.fas.fa-envelope
        span 联系
  .site-footer__bottom
    span &copy; #{sinceYear} - #{currentYear} if-else
    span.site-footer__stack
      | Hexo
      span.site-footer__dot ·
      | Butterfly
