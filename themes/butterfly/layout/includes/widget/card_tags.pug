if theme.aside.card_tags.enable
  if site.tags.length
    .card-widget.card-tags.aside-tag-card
      .item-headline
        i.fas.fa-tags
        span= _p('aside.card_tags')
        a.aside-card__more(href=url_for(config.tag_dir) + '/' title='查看全部标签' aria-label='查看全部标签')
          i.fas.fa-arrow-right

      .aside-tag-card__hint 按主题探索文章

      - let { limit, orderby, order } = theme.aside.card_tags
      - limit = limit === 0 ? 0 : limit || 40

      if theme.aside.card_tags.color
        .card-tag-cloud!= cloudTags({source: site.tags, orderby: orderby, order: order, minfontsize: 0.82, maxfontsize: 1.08, limit: limit, unit: 'em'})
      else
        .card-tag-cloud!= tagcloud({orderby: orderby, order: order, min_font: 1.1, max_font: 1.5, amount: limit , color: true, start_color: '#999', end_color: '#99a9bf', unit: 'em'})
