- const vercountUrl = theme.asset.busuanzi || '//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js'

script.
  (() => {
    const selector = [
      '#busuanzi_value_site_uv',
      '#busuanzi_value_site_pv',
      '#busuanzi_value_page_pv',
      '#vercount_value_site_uv',
      '#vercount_value_site_pv',
      '#vercount_value_page_pv'
    ].join(',')
    const source = !{JSON.stringify(vercountUrl)}
    const scriptId = 'vercount-dynamic-script'
    let observer = null
    let timeoutId = null
    let activeRun = 0

    const getTargets = () => Array.from(document.querySelectorAll(selector))

    const clearWatch = () => {
      observer && observer.disconnect()
      observer = null
      clearTimeout(timeoutId)
      timeoutId = null
    }

    const removeScript = () => {
      document.getElementById(scriptId)?.remove()
    }

    const isResolved = target => {
      const value = target.textContent.trim()
      return value !== '' && value !== '--' && !target.querySelector('.fa-spinner')
    }

    const finish = targets => {
      clearWatch()
      targets.forEach(target => {
        target.setAttribute('aria-busy', 'false')
        target.classList.remove('vercount-unavailable')
        target.removeAttribute('aria-label')
        target.removeAttribute('title')
      })
    }

    const showFallback = (targets, message = '访问统计暂时不可用') => {
      clearWatch()
      targets.forEach(target => {
        target.replaceChildren(document.createTextNode('--'))
        target.setAttribute('aria-busy', 'false')
        target.setAttribute('aria-label', message)
        target.setAttribute('title', message)
        target.classList.add('vercount-unavailable')
      })
    }

    const cancel = () => {
      activeRun += 1
      clearWatch()
      removeScript()
    }

    const init = () => {
      cancel()
      const run = activeRun
      const targets = getTargets()

      if (GLOBAL_CONFIG_SITE.isHome) {
        targets.length && showFallback(targets, '首页暂不加载访问统计')
        return
      }

      if (!targets.length) return

      targets.forEach(target => {
        target.setAttribute('aria-busy', 'true')
        target.classList.remove('vercount-unavailable')
        target.removeAttribute('aria-label')
        target.removeAttribute('title')
      })

      const checkResult = () => {
        if (run !== activeRun) return
        if (targets.every(isResolved)) finish(targets)
      }

      observer = new MutationObserver(checkResult)
      targets.forEach(target => observer.observe(target, {
        childList: true,
        subtree: true,
        characterData: true
      }))

      const script = document.createElement('script')
      script.id = scriptId
      script.async = true
      script.src = source
      script.addEventListener('error', () => {
        if (run === activeRun) showFallback(targets)
      }, { once: true })
      document.head.appendChild(script)

      timeoutId = setTimeout(() => {
        if (run === activeRun && !targets.every(isResolved)) showFallback(targets)
      }, 9000)
    }

    const previousLoader = window.vercountLoader
    previousLoader && previousLoader.destroy()

    const handlePjaxSend = () => cancel()
    const handlePjaxComplete = () => init()
    document.addEventListener('pjax:send', handlePjaxSend)
    document.addEventListener('pjax:complete', handlePjaxComplete)

    window.vercountLoader = {
      init,
      destroy: () => {
        cancel()
        document.removeEventListener('pjax:send', handlePjaxSend)
        document.removeEventListener('pjax:complete', handlePjaxComplete)
      }
    }

    init()
  })()
