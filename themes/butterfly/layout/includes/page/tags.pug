-
  const knowledgeNodes = []
  const knowledgeNodeNames = new Set()
  const knowledgeLinksByPair = new Map()

  site.tags.each(function (tag) {
    const postCount = tag.posts && typeof tag.posts.length === 'number' ? tag.posts.length : 0
    knowledgeNodes.push({
      id: tag.name,
      name: tag.name,
      url: url_for(tag.path),
      count: postCount
    })
    knowledgeNodeNames.add(tag.name)
  })

  site.posts.each(function (post) {
    const postTags = post.tags && post.tags.data ? post.tags.data : []
    const names = Array.from(new Set(postTags.map(function (tag) { return tag.name })))

    for (let sourceIndex = 0; sourceIndex < names.length; sourceIndex += 1) {
      for (let targetIndex = sourceIndex + 1; targetIndex < names.length; targetIndex += 1) {
        const pair = [names[sourceIndex], names[targetIndex]].sort()
        const key = pair.join('\u0000')
        knowledgeLinksByPair.set(key, (knowledgeLinksByPair.get(key) || 0) + 1)
      }
    }
  })

  const knowledgeLinks = Array.from(knowledgeLinksByPair.entries())
    .map(function (entry) {
      const pair = entry[0].split('\u0000')
      return { source: pair[0], target: pair[1], weight: entry[1] }
    })
    .filter(function (link) {
      return knowledgeNodeNames.has(link.source) && knowledgeNodeNames.has(link.target)
    })
    .sort(function (first, second) { return second.weight - first.weight })

  knowledgeNodes.sort(function (first, second) {
    return second.count - first.count || first.name.localeCompare(second.name)
  })

  const knowledgeGraphJson = JSON.stringify({ nodes: knowledgeNodes, links: knowledgeLinks })
    .replace(/</g, '\\u003c')

section.knowledge-map(aria-labelledby='knowledge-map-title')
  header.knowledge-map__header
    .knowledge-map__heading
      .knowledge-map__eyebrow
        i.fas.fa-project-diagram(aria-hidden='true')
        span KNOWLEDGE MAP
      h2#knowledge-map-title 知识轨迹
      p 从课程复习到嵌入式实践，每条连线都来自文章中共同出现的标签。拖动球体可从不同方向探索主题。
    .knowledge-map__stats(aria-label='图谱统计')
      span
        strong= knowledgeNodes.length
        | 个主题
      span
        strong= knowledgeLinks.length
        | 条关联

  .knowledge-graph(data-knowledge-graph)
    canvas.knowledge-graph__canvas(tabindex='0' role='img' aria-label='可旋转的球形博客标签知识图谱')
    .knowledge-graph__tooltip(role='status' aria-live='polite' hidden)

    form.knowledge-graph__search(role='search')
      i.fas.fa-search(aria-hidden='true')
      input(type='search' data-graph-search autocomplete='off' placeholder='搜索主题' aria-label='搜索知识图谱主题')
      button(type='button' data-graph-search-clear title='清除搜索' aria-label='清除搜索' hidden)
        i.fas.fa-times(aria-hidden='true')
      span.knowledge-graph__search-status(data-graph-search-status aria-live='polite')

    aside.knowledge-graph__detail(data-graph-detail aria-live='polite' hidden)
      button.knowledge-graph__detail-close(type='button' data-graph-detail-close title='关闭详情' aria-label='关闭主题详情')
        i.fas.fa-times(aria-hidden='true')
      .knowledge-graph__detail-kicker
        i.fas.fa-link(aria-hidden='true')
        span 主题关系
      strong.knowledge-graph__detail-title(data-graph-detail-title)
      .knowledge-graph__detail-meta
        span
          i.far.fa-file-alt(aria-hidden='true')
          b(data-graph-detail-count) 0
          | 篇文章
        span
          i.fas.fa-project-diagram(aria-hidden='true')
          b(data-graph-detail-relations) 0
          | 个关联
      .knowledge-graph__detail-related(data-graph-detail-related)
      a.knowledge-graph__detail-link(data-graph-detail-link href='#')
        span 浏览相关文章
        i.fas.fa-arrow-right(aria-hidden='true')

    .knowledge-graph__controls(aria-label='知识图谱视图控制')
      button(type='button' data-graph-action='random' title='随机探索' aria-label='随机探索一个主题')
        i.fas.fa-random(aria-hidden='true')
      button(type='button' data-graph-action='motion' title='暂停动态' aria-label='暂停图谱动态' aria-pressed='false')
        i.fas.fa-pause(data-graph-motion-icon aria-hidden='true')
      button(type='button' data-graph-action='zoom-in' title='放大' aria-label='放大图谱')
        i.fas.fa-plus(aria-hidden='true')
      button(type='button' data-graph-action='zoom-out' title='缩小' aria-label='缩小图谱')
        i.fas.fa-minus(aria-hidden='true')
      button(type='button' data-graph-action='reset' title='复位' aria-label='复位图谱')
        i.fas.fa-compress-arrows-alt(aria-hidden='true')

    nav.knowledge-graph__links(aria-label='全部标签')
      each node in knowledgeNodes
        a(href=node.url data-graph-node=node.id aria-label=node.name + '，' + node.count + ' 篇文章')= node.name

script#knowledge-graph-data(type='application/json')!= knowledgeGraphJson
script(src=url_for('/js/knowledge-graph.js') defer)

noscript
  .tag-cloud-list.is-center
    !=cloudTags({source: site.tags, orderby: page.orderby || 'length', order: page.order || -1, minfontsize: 0.82, maxfontsize: 1.08, limit: 0, unit: 'rem'})
